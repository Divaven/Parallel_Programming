bool isPrime(int n) {
    if (n < 2) {
        return false;
    }

    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            return false;
        }
    }

    return true;
}

void fifthteen () {
    int left, right;

    cout << "Enter range: ";
    cin >> left >> right;

    cout << "Prime numbers:" << endl;

#pragma omp parallel for num_threads(4)
    for (int i = left; i <= right; i++) {
        if (isPrime(i)) {
#pragma omp critical
            {
                cout << i << " ";
            }
        }
    }

    cout << endl;

    /*
     С помощью parallel for числа из диапазона распределяются между потоками.
     Каждый поток независимо проверяет своё число на простоту. Для проверки достаточно искать делители до
     квадратного корня числа. Если число простое, оно выводится в критической секции, чтобы несколько
     потоков одновременно не обращались к cout.
     */
}
