void ten () {
    int a[30];
    int count = 0;

    srand(time(nullptr));

    // Заполняем массив случайными числами от 0 до 99
    for (int i = 0; i < 30; i++) {
        a[i] = rand() % 100;
    }

    cout << "Array:" << endl;

    for (int i = 0; i < 30; i++) {
        cout << a[i] << " ";
    }

    cout << endl;

#pragma omp parallel for num_threads(4)
    for (int i = 0; i < 30; i++) {
        if (a[i] % 9 == 0) {
#pragma omp atomic
            count++;
        }
    }

    cout << "Count = " << count << endl;

    /*
     critical защищает целый блок кода, а atomic — одну простую операцию над общей переменной.
     Поэтому для count++ удобнее использовать именно atomic
     */
}
