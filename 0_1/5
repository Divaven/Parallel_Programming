void fifth () {
    int d[6][8];

    // Заполняем массив случайными числами от 0 до 99
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 8; j++) {
            d[i][j] = rand() % 100;
        }
    }

    cout << "Array:" << endl;

    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 8; j++) {
            cout << d[i][j] << "\t";
        }
        cout << endl;
    }

    cout << endl;

#pragma omp parallel num_threads(3)
    {
#pragma omp sections
        {
            // Секция 1: среднее арифметическое
#pragma omp section
            {
                int sum = 0;

                for (int i = 0; i < 6; i++) {
                    for (int j = 0; j < 8; j++) {
                        sum += d[i][j];
                    }
                }

                double average = static_cast<double>(sum) / 48;

#pragma omp critical
                {  // Номер потока
                    cout << "Thread " << omp_get_thread_num() << ": average = " << average << endl;
                }
            }

            // Секция 2: min и max
#pragma omp section
            {
                int minValue = d[0][0];
                int maxValue = d[0][0];

                for (int i = 0; i < 6; i++) {
                    for (int j = 0; j < 8; j++) {
                        if (d[i][j] < minValue) {
                            minValue = d[i][j];
                        }

                        if (d[i][j] > maxValue) {
                            maxValue = d[i][j];
                        }
                    }
                }

#pragma omp critical
                {
                    cout << "Thread " << omp_get_thread_num() << ": min = " << minValue << ", max = " << maxValue << endl;
                }
            }

            // Секция 3: количество чисел, кратных 3
#pragma omp section
            {
                int count = 0;

                for (int i = 0; i < 6; i++) {
                    for (int j = 0; j < 8; j++) {
                        if (d[i][j] % 3 == 0) {
                            count++;
                        }
                    }
                }

#pragma omp critical
                {
                    cout << "Thread " << omp_get_thread_num() << ": divisible by 3 = " << count << endl;
                }
            }
        }
    }
}
